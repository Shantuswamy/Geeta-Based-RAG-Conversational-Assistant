# Groq API Key (Used by query classifier)
GROQ_API_KEY="your_groq_api_key_here"

# Google Gemini API Key (Optional / Alternate LLM client)
GOOGLE_API_KEY="your_gemini_api_key_here"

# Hugging Face API Token (Optional / For gated model downloads if needed)
HF_API_KEY="your_huggingface_token_here"

